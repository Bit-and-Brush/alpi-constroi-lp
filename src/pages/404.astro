---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main id="main-content" tabindex="-1" class="w-full py-24 md:py-32">
    <div class="container mx-auto px-6">
      <div class="flex flex-col items-center justify-center text-center gap-8">
        <h1 class="text-6xl md:text-7xl font-bold text-foreground">404</h1>
        <h2 class="text-3xl md:text-4xl font-bold text-foreground">
          Página não encontrada
        </h2>
        <p class="text-lg text-foreground/80 max-w-lg">
          Desculpe, a página que está a procurar não existe ou foi movida.
        </p>
        <a
          href="/"
          class="mt-4 bg-primary text-white font-semibold px-8 py-3 rounded-full uppercase tracking-widest transition-all hover:opacity-85 hover:shadow-lg active:scale-95"
        >
          Voltar à Home
        </a>
      </div>
    </div>
  </main>
</Layout>
